<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gestor.libros.app.controller.PrincipalController">

    <!-- ── Barra lateral izquierda ── -->
    <left>
        <VBox styleClass="sidebar" spacing="4" prefWidth="200">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>

            <Label text="📚 Mis Libros" styleClass="sidebar-titulo"/>
            <Separator style="-fx-opacity:0.3;"/>

            <Button fx:id="btnLibros"    text="📖  Biblioteca"
                    maxWidth="Infinity" onAction="#mostrarLibros"
                    styleClass="nav-btn"/>
            <Button fx:id="btnLecturas"  text="📊  Lecturas"
                    maxWidth="Infinity" onAction="#mostrarLecturas"
                    styleClass="nav-btn"/>
            <Button fx:id="btnAutores"   text="👤  Autores"
                    maxWidth="Infinity" onAction="#mostrarAutores"
                    styleClass="nav-btn"/>
            <Button fx:id="btnFavoritos" text="⭐  Favoritos"
                    maxWidth="Infinity" onAction="#mostrarFavoritos"
                    styleClass="nav-btn"/>

            <!-- Empuja el bloque de backup al fondo -->
            <VBox VBox.vgrow="ALWAYS"/>

            <!-- ── Sección de Backup ── -->
            <Separator style="-fx-opacity:0.3;"/>
            <Button fx:id="btnBackup" text="💾  Backup ahora"
                    maxWidth="Infinity" onAction="#hacerBackupManual"
                    styleClass="nav-btn, btn-backup"/>
            <Label fx:id="lblBackupEstado" text=""
                   styleClass="backup-estado"
                   maxWidth="Infinity" wrapText="true"/>

            <Label text="Gestor de Libros v1.0" styleClass="sidebar-footer"/>
        </VBox>
    </left>

    <!-- ── Contenido principal ── -->
    <center>
        <StackPane fx:id="contenidoPrincipal" styleClass="contenido-principal"/>
    </center>

</BorderPane>
